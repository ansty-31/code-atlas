node_modules

# Build output: the bundled app plus the generated JSON bundle (dist/data/).
# Both are produced by `npm run build` and are never committed.
dist/

# Local tooling (headless browser + its shared libraries + screenshots + trailer)
.npm-cache/
.pw-browsers/
.pw-libs/
.pw-shots/
.pw-video/

# Local configuration, reports and session notes are not release source.
.env
.env.*
!.env.example
docs/development-pause.md
*.log
